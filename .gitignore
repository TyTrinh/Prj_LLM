# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
*.egg-info/


# Virtual Environment
.venv/
venv/
env/

# Large data & checkpoints (Never commit large binaries to git)
data/*.bin
data/*.jsonl
data/*.parquet
checkpoints/**/*.pt
checkpoints/**/*.bin
checkpoints/*.pt
checkpoints/*.bin
!checkpoints/.gitkeep
!data/.gitkeep

# Logs & Monitoring
wandb/
runs/
*.log

# Jupyter Notebook artifacts
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# OS & IDE
.vscode/
.idea/
.DS_Store
Thumbs.db
